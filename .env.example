# Copy this file to `.env.local` and fill in values. `.env*` is gitignored.

# Public site URL — used for metadata and absolute links. Production uses
# https://cosmosgroupusa.com (also the default); override for local/preview.
NEXT_PUBLIC_SITE_URL="https://cosmosgroupusa.com"

# --- Quote requests (/api/quote) ---
# Default/unset: legacy. Keep the existing Supabase inbox until a coordinated
# cutover. Success requires a persisted row; email is only a notification.
# "customer" is authenticated intake v2: a signed-in client sends through the
# Studio's customer API. It needs that API and client accounts both configured,
# or it blocks. "studio" is the isolated v1 test adapter and keeps the browser
# blocked. Neither falls back to legacy. Unknown mode values also block.
# Production Studio delivery is blocked. See docs/client-accounts.md.
QUOTE_DELIVERY_MODE="legacy"

# Isolated local / protected Preview testing ONLY. Leave unset in Production.
# v1 test adapter: QUOTE_DELIVERY_MODE=studio plus STUDIO_INTAKE_URL.
# Customer API v2 and account history: STUDIO_CUSTOMER_API_URL (below).
# Both need this gate, an explicit trusted endpoint and the secret.
# Local accepts loopback only; Vercel Preview requires HTTPS. No production
# Cosmos host, redirects, query strings or credentials in the URL are accepted.
# QUOTE_STUDIO_TEST_ENABLED="true"
# STUDIO_INTAKE_URL="http://127.0.0.1:<assigned-studio-port>/api/webhooks/website"
# STUDIO_CUSTOMER_API_URL="http://127.0.0.1:<assigned-studio-port>/api/customer/v2"
# WEBSITE_INTAKE_SECRET=""
# Production only, set at an approved cutover (docs/launch-cutover.md). The test
# switch above never opens Production, and this one opens nothing else.
# CUSTOMER_API_PRODUCTION_ENABLED="true"
# Production's STUDIO_CUSTOMER_API_URL must be exactly one of
# https://studio.cosmosgroupusa.com/api/customer/v2 (proposed, not live yet)
# https://studio.cosmosservicesllc.com/api/customer/v2 (during the domain move)
# Studio owner sets the matching isolated DB hash and WEBSITE_INTAKE_ENABLED.
# Do not use production data/credentials. Configure shared Vercel WAF rate
# limiting for POST /api/quote before public Preview/rollout; see integration doc.

# Supabase: table created by supabase/migrations/*_create_quote_requests.sql.
# Use the secret key (sb_secret_…). Server only: never prefix with NEXT_PUBLIC_.
# SUPABASE_URL=""
# SUPABASE_SECRET_KEY=""

# Resend (https://resend.com): sender must be on a domain verified in Resend.
# RESEND_API_KEY=""
# QUOTE_TO_EMAIL=""
# QUOTE_FROM_EMAIL=""

# --- Client accounts (lib/account; see docs/client-accounts.md) ---
# Email/password sign-in via Supabase Auth, server only. Production: the
# Studio's Supabase project, publishable key only, never a secret key. Leave
# unset until the Studio's identity/ownership work is verified; unset means
# accounts are off. Local dev may use this repo's isolated local stack.
# AUTH_SUPABASE_URL=""
# AUTH_SUPABASE_PUBLISHABLE_KEY=""

# --- Operations Studio (lib/studio-routes.ts) ---
# Where the Studio's recipient paths (/o, /q, /pay, /join, /me, /terms) are
# forwarded. Defaults to https://studio.cosmosgroupusa.com, which isn't live yet:
# Production sets https://studio.cosmosservicesllc.com until it is.
# For paired staging, set it to the matching Studio preview origin. HTTPS
# origin only (HTTP on localhost); no path. Read at build time.
# STUDIO_ORIGIN=""
# Vercel Preview only. The exact Studio Preview origin an operator approved; a
# Preview build fails unless STUDIO_ORIGIN equals it, and nothing is sent to any
# other host. See docs/protected-preview-access.md.
# STUDIO_APPROVED_ORIGIN=""
# A Preview reaches the protected Studio Preview with Vercel Trusted Sources: a
# short-lived token from each request's context, so there's no secret to set here.
