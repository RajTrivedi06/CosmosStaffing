# Copy this file to `.env.local` and fill in values. `.env*` is gitignored.

# Public site URL — used for metadata and absolute links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Quote requests (/api/quote) ---
# Each request is stored in Supabase, then emailed to the team. A request
# counts as delivered if either succeeds. With neither configured, the quote
# screen tells visitors online requests aren't connected yet.

# Supabase: table created by supabase/migrations/*_create_quote_requests.sql.
# Use the secret key (sb_secret_…). Server only: never prefix with NEXT_PUBLIC_.
# SUPABASE_URL=""
# SUPABASE_SECRET_KEY=""

# Resend (https://resend.com): sender must be on a domain verified in Resend.
# RESEND_API_KEY=""
# QUOTE_TO_EMAIL=""
# QUOTE_FROM_EMAIL=""
